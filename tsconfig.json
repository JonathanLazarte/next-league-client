{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
        "paths": {
          "$/*": ["./app/*"],
          "@/*": ["./src/*"],
          "@/components/*": ["./src/components/*"],
          "@/pages/*": ["./src/pages/*"],
          "@/redux/*": ["./src/redux/*"],
          "@/hooks/*": ["./src/hooks/*"],
          "@/services/*": ["./src/services/*"],
          "@/svg/*": ["./src/svg/*"]
        },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
       /*"noImplicitAny": true,          //Prohíbe el uso de 'any' implícito
       "strictNullChecks": true,       // Evita que uses variables que podrían ser null o undefined
       "noUnusedLocals": true,         // Alerta si dejas variables declaradas sin usar
       "noUnusedParameters": true,*/
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx"
, "postcss.config.js", "tailwind.config.js", "next.config.js", "src/components/Settings/Settings"  ],
  "exclude": [
    "node_modules"
  ]
}
